# GPU Monitor — Configuração Docker Compose
# Copie este arquivo para .env e edite conforme necessário

# Custo por hora da GPU em USD (ex: AWS p3.2xlarge = 3.06)
GPU_COST_PER_HOUR=2.50

# Identificador desta máquina
MACHINE_ID=machine-01

# Intervalo de coleta em segundos
SEND_INTERVAL=5

# Slack (opcional) — cole o webhook URL para receber alertas
SLACK_WEBHOOK_URL=

# Cooldown entre alertas (minutos)
ALERT_COOLDOWN_MINUTES=10
